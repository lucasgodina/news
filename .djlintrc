{
    "indent": 4,
    "profile": "django",
    "ignore": "H006,H014,H030,H031,T003,jinja-formatting",
    "extend": ".html",
    "exclude": "node_modules,.venv,static,media,migrations",
    "format_attribute_template_tags": false,
    "preserve_leading_space": true,
    "preserve_blank_lines": true,
    "max_line_length": 120,
    "format_css": false,
    "format_js": false,
    "close_void_tags": false
}
